{
  "manifest_version": 2,
  "name": "Blockfield Tetris",
  "version": "0.2.0",
  "description": "A local Tetris game in your Firefox sidebar.",
  "permissions": [],
  "browser_action": {"default_title": "Open Blockfield"},
  "sidebar_action": {"default_title": "Blockfield", "default_panel": "index.html", "open_at_install": false, "browser_style": false},
  "background": {"scripts": ["background.js"], "persistent": false},
  "content_security_policy": "script-src 'self'; object-src 'self'",
  "browser_specific_settings": {"gecko": {"id": "blockfield@tetris.invalid", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}
}
